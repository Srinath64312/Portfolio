# Copy this file to .env and fill in a real endpoint to enable the contact
# form to send messages via Formspree or Web3Forms. If left unset, the
# contact form falls back to opening the visitor's email client instead.
#
# Formspree:  https://formspree.io  -> https://formspree.io/f/your-form-id
# Web3Forms:  https://web3forms.com -> https://api.web3forms.com/submit
VITE_CONTACT_FORM_ENDPOINT=
